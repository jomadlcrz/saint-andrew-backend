# St. Andrew Funeral Home Backend Configuration
PORT=3000
NODE_ENV=development

# Semaphore SMS API (Philippines Mobile SMS Gateway)
# If left unset, outgoing SMS will be logged to console in simulated mode
SEMAPHORE_API_KEY=

# Brevo Transactional Email API (Support tickets, OTP, password reset)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=saintandrewfh@gmail.com

# Firebase Admin SDK Configuration
# Either provide the inline JSON string or place the service-account.json in the backend directory
FIREBASE_SERVICE_ACCOUNT_JSON=

# Allowed Origins for CORS (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
